swipe_sources:
  - meta_ad_library
  - google_transparency_center
  - tiktok_creative_center
  - linkedin_ad_library
  - spy_tools
  - perpetual_traffic_podcast
  - sobral_lives
  - award_archives

curation_rules:
  - proven_performers_only
  - include_metrics_when_available
  - tag_by_platform_and_funnel_stage
  - tag_by_industry
  - tag_by_angle_and_hook
  - include_context_and_hypothesis
  - never_include_copyrighted_content_verbatim

tag_schema:
  platform:
    - meta
    - google
    - youtube
    - tiktok
    - linkedin
    - pinterest
    - programmatic
  funnel_stage:
    - tofu
    - mofu
    - bofu
    - retention
  format:
    - image
    - video
    - carousel
    - ugc
    - collection
    - text_only
    - rsa
    - shopping
  angle:
    - pain
    - desire
    - objection
    - proof
    - mechanism
    - authority
    - social_proof
    - curiosity
  hook_type:
    - pattern_interrupt
    - curiosity
    - authority
    - social_proof
    - controversy
    - question
    - statistic
    - story
  industry:
    - ecommerce
    - infoproduct
    - saas
    - local_business
    - high_ticket
    - education
    - health
    - finance
    - real_estate
    - app
    - gaming
    - food
    - crypto

review_cadence:
  new_additions: weekly
  full_audit: quarterly
  archive_old: after_6_months
